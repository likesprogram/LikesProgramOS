{
    // C/C++ 扩展（ms-vscode.cpptools）的配置；用 clangd 的话这个文件不生效
    "version": 4,
    "configurations": [
        {
            "name": "LikesProgramOS",
            // 编译数据库是真源，由 make compile-db 生成，覆盖所有已进构建的源；
            // includePath 只给还没接上构建的源码（如 Packages/Baleen/Core）兜底
            "compileCommands": "${workspaceFolder}/compile_commands.json",
            "includePath": [
                "${workspaceFolder}/Packages/Common/Include",
                "${workspaceFolder}/Packages/Baleen/Common/Include",
                "${workspaceFolder}/Packages/Baleen/Stub/Include",
                "${workspaceFolder}/Tools/Build/Common/Include"
            ],
            "cStandard": "c17",
            "cppStandard": "c++20",
            "intelliSenseMode": "linux-gcc-x86"
        }
    ]
}
